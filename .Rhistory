# load add-on packages
library(tidyverse)
# set object ----
n <- 100
# simulate data ----
data <- data.frame(
id = 1:n,
dv = c(rnorm(n/2, 0), rnorm(n/2, 1)),
condition = rep(c("A", "B"), each = n/2)
)
# plot data ----
ggplot(data, aes(condition, dv)) +
geom_violin(trim = FALSE) +
geom_boxplot(width = 0.25,
aes(fill = condition),
show.legend = FALSE)
# save plot ----
ggsave("sim_data.png", width = 8, height = 6)
